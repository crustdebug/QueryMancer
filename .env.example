# Database credentials are NOT configured here.
#
# You connect your database inside the app: open the sidebar, pick the database
# type, and enter your details or a connection string. Credentials are held in
# your browser session only - never written to disk, never logged.
#
# Optionally, for local development, DATABASE_URL pre-fills the connection form:
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# DATABASE_URL=mysql://user:password@localhost:3306/mydb
# DATABASE_URL=sqlite:///C:/data/app.db

# --- API keys ------------------------------------------------------------
# Every provider accepts a POOL of keys. The app rotates through them
# round-robin and benches any key the provider reports as rate-limited, so
# several free-tier keys add up to a usable request budget.
#
# Two forms work, and you can mix them. Either a comma-separated list:
GOOGLE_API_KEY=key_one,key_two,key_three
#
# ...or numbered variables, which are easier to edit (up to _20):
# GOOGLE_API_KEY_1=key_one
# GOOGLE_API_KEY_2=key_two
# GOOGLE_API_KEY_3=key_three
#
# Get free Gemini keys at https://aistudio.google.com/apikey - create a
# separate Google Cloud project per key, since the free quota is per project.

# Optional fallback providers. When every Gemini key is exhausted, the app
# moves down this list automatically. Each has its own separate free quota.
# GROQ_API_KEY=          # https://console.groq.com/keys
# TOGETHER_API_KEY=      # https://api.together.ai/settings/api-keys
# PERPLEXITY_API_KEY=    # https://www.perplexity.ai/settings/api

# No key is needed for Ollama; just run it locally as a last-resort fallback.
